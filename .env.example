# Discord Bot Token
DISCORD_TOKEN=

# Bot Command Prefix (Default: b.)
PREFIX=b.

# Rule34 API Authentication
RULE34_USER_ID=
RULE34_API_KEY=

# Optional: NHentai API Key
NHENTAI_API_KEY=

# Optional: AI Image Generation
POLLINATIONS_API_KEY=
HORDE_API_KEY=
HORDE_TIMEOUT_MS=600000

# Network & Timeouts
REQUEST_TIMEOUT_MS=12000
IMAGE_GEN_TIMEOUT_MS=120000
RULE34_MAX_ATTEMPTS=4
RULE34_PAGE_POOL=150
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Admin Passwords & Countdowns
NUKE_PASSWORD=
PURGE_PASSWORD=
NUKE_COUNTDOWN_SECONDS=10
PURGE_COUNTDOWN_SECONDS=10
